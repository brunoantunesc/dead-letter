[gd_resource type="Resource" script_class="EvidenceDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/catalog/evidence_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "scene_trace.storage"
selector = {"observation_type": "scene_trace", "scene_profile": "storage"}
title_key = "evidence.scene_trace.storage.title"
text_key = "evidence.scene_trace.storage.body"
parameters = {"marks": {"field": "detail_token", "format": "term"}}
visual_id = "visual.scene_trace.storage"
category_id = "material.trace"
claim_ids = PackedStringArray("scene_mechanism")
causal_kinds = PackedStringArray("murder", "cut", "lifting", "inspection", "sports", "cleaning")
observation_fields = PackedStringArray("signature", "detail_token", "object_id", "place")
observable_titles = {"scene.storage.stabbing": {"title_key": "evidence.scene.storage.stabbing.title", "short_key": "evidence.scene.storage.stabbing.short"}, "scene.storage.strangulation": {"title_key": "evidence.scene.storage.strangulation.title", "short_key": "evidence.scene.storage.strangulation.short"}, "scene.storage.gunshot": {"title_key": "evidence.scene.storage.gunshot.title", "short_key": "evidence.scene.storage.gunshot.short"}, "scene.storage.blunt_force": {"title_key": "evidence.scene.storage.blunt_force.title", "short_key": "evidence.scene.storage.blunt_force.short"}, "scene.storage.poisoning": {"title_key": "evidence.scene.storage.poisoning.title", "short_key": "evidence.scene.storage.poisoning.short"}}
